# MongoDB Atlas connection string — from Atlas: Database > Connect > Drivers.
# Include a database name in the path (e.g. /fisure) so all data lands in one place.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fisure?retryWrites=true&w=majority"
PORT=4000
SESSION_DAYS=7
PAYMENTS_ENABLED=false
PAYMENTS_SIMULATE=true
CONTRIBUTIONS_PUBLIC=false
PAYOUTS_AUTOMATED=false
# Comma-separated list — include every frontend origin that calls this API
# (e.g. your Vercel URL and, while still developing locally, localhost:3000).
UI_ORIGIN=http://localhost:3000

# Set to "true" only once this API is served over HTTPS (a plain HTTP origin
# will silently reject "Secure" cookies, breaking login entirely). Required
# whenever the frontend and backend are on different domains — a same-site
# "lax" cookie is never sent on cross-site requests. Leave "false" for local
# dev, where frontend and backend share http://localhost.
COOKIE_CROSS_SITE=false

# Cloudinary — document/file storage backend (server/src/lib/storage.ts).
# From Cloudinary dashboard: Cloud name is the short slug; API Key is numeric;
# API Secret is the long mixed string. Files are stored as private "raw"
# resources — never publicly reachable by URL — and served only through this
# app's own permission-checked /documents/:id endpoint.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend — outbound email (server/src/lib/email.ts). Real delivery for
# notifications (trigger matches, claims, KYC failures, listing fully funded,
# policy bound, new carrier quote requests). Sending is skipped (logged only)
# if RESEND_API_KEY is unset, so the app still runs without it in dev.
# onboarding@resend.dev works immediately with no domain verification —
# swap in a verified domain's address later without any code change.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="FiSure <onboarding@resend.dev>"

# Stripe — real payment collection for contributions (server/src/lib/stripe.ts,
# routes/webhooks.ts). Leave STRIPE_SECRET_KEY empty (and PAYMENTS_ENABLED
# false, above) to keep the existing ledger-only simulated flow — nothing
# changes until both a key is set here AND PAYMENTS_ENABLED=true.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to
# localhost:4000/webhooks/stripe` in local dev, or the Dashboard's webhook
# endpoint config in production — required to verify that a webhook request
# genuinely came from Stripe before trusting it to record real money received.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
