# MongoDB Atlas connection string — from Atlas: Database > Connect > Drivers.
# Include a database name in the path (e.g. /fisure) so all data lands in one place.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fisure?retryWrites=true&w=majority"
PORT=4000
SESSION_DAYS=7
PAYMENTS_ENABLED=false
PAYMENTS_SIMULATE=true
CONTRIBUTIONS_PUBLIC=false
PAYOUTS_AUTOMATED=false
# Comma-separated list — include every frontend origin that calls this API
# (e.g. your Vercel URL and, while still developing locally, localhost:3000).
UI_ORIGIN=http://localhost:3000

# Set to "true" only once this API is served over HTTPS (a plain HTTP origin
# will silently reject "Secure" cookies, breaking login entirely). Required
# whenever the frontend and backend are on different domains — a same-site
# "lax" cookie is never sent on cross-site requests. Leave "false" for local
# dev, where frontend and backend share http://localhost.
COOKIE_CROSS_SITE=false
