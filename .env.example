# MongoDB Atlas connection string — from Atlas: Database > Connect > Drivers.
# Include a database name in the path (e.g. /fisure) so all data lands in one place.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fisure?retryWrites=true&w=majority"
PORT=4000
SESSION_DAYS=7
PAYMENTS_ENABLED=false
PAYMENTS_SIMULATE=true
CONTRIBUTIONS_PUBLIC=false
PAYOUTS_AUTOMATED=false
UI_ORIGIN=http://localhost:3000
